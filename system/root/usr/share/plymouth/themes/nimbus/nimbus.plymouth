[Plymouth Theme]
Name=Nimbus Paper Dark
Description=Neutral monochrome boot and disk-unlock screen
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/nimbus
ScriptFile=/usr/share/plymouth/themes/nimbus/nimbus.script
Font=DejaVu Sans Mono 20
MonospaceFont=DejaVu Sans Mono 20
ConsoleLogBackgroundColor=0x101010
